      NodeType: 1
      Ports:
        Code:
          ClassType1: TEXT
          String: |
            // MetalUnlit515 - textured unlit base (runtime sets baseTex/baseColor/blend)
            input_texture_2d baseTex;
            input_color4 baseColor;
            
            void main() {
                vec2 uv = system.getSurfaceUVCoord0();
                vec4 t = baseTex.sample(uv);
                fragColor = t * baseColor;
            }

        Description:
          ClassType1: TEXT
          String: ""
        Examples:
          ItemIndex: 0
          ItemList: "Custom : Input/Output/Global Types : Extra Functions : Procedural Execution : Lighting Loop : System Built-In Values/Functions"
        ID:
          Variable: 0
        Locked:
          Variable: false
        Stage:
          ItemIndex: 1
          ItemList: "Vertex : Pixel"
        Title:
          String: Custom Code
        baseColor:
          ClassType1: COLOR
          Connection0:
            NodeLevelID: 3
            PortID: Output
          Variable: [0.0, 0.0, 0.0, 1.0]
        baseTex:
          ClassType1: LINK
          Connection0:
            NodeLevelID: 2
            PortID: Texture
