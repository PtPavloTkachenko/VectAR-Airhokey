          Variable: [0.0, 0.0, 0.0, 0.0]
        driftAmount:
          Variable: 1.0
        driftSpeed:
          Variable: 1.0
        endColor:
          ClassType1: COLOR
          Variable: [1.0, 0.0, 0.016662852838635445, 1.0]
        glyphAtlas:
          ClassType2: TEXTURE_OBJECT_2D
          Connection0:
            NodeLevelID: 1
