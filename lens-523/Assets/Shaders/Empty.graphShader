    Node1:
      DependencyIndex: 1
      LevelID: 0
      NodeCount: 0
      NodeType: 1
      Ports:
        Code:
          ClassType1: TEXT
          String: |
            input_texture_2d glyphAtlas;
            input_float boundsX;
            input_float boundsY;
            input_float boundsZ;
            input_float lifetime;
            input_color4 startColor;
            input_color4 endColor;
            input_float particleScale;
            input_float driftAmount;
            input_float driftSpeed;
            
            output_vec3 position;
            output_vec4 color;
            
            // Hoskins 1D hash — no sin(), FP16-safe even with id > 1000.
            // Original sin-based hash overflowed FP16 (id * 127.1 = 127100 > 65504 max).
            float hash(float n) {
                n = fract(n * 0.1031);
                n *= n + 33.33;
                n *= n + n;
                return fract(n);
            }
            
            void main() {
                float id = float(system.getInstanceID());
                float time = system.getTimeElapsed();
            
                float r0 = hash(id);
                float r1 = hash(id + 13.0);
                float r2 = hash(id + 37.0);
                float r3 = fract(r0 + r1);
                float r4 = fract(r1 + r2);
            
                float lifeT = (time + r0 * lifetime) / lifetime;
                float progress = fract(lifeT);
                float cycleId = floor(lifeT);
            
                float px = (r1 - 0.5) * 2.0 * boundsX;
                float py = (r2 - 0.5) * 2.0 * boundsY;
                float pz = (r3 - 0.5) * 2.0 * boundsZ;
            
                // PRECISION: wrap drift-time to [0, 2π) so sin() args stay FP16-precise.
                // Without this, at long playtime ft grows unbounded -> sin precision degrades.
                float phase = r4 * 6.2831;
                float spd = driftSpeed * (0.7 + r0 * 0.6);
                float ft = mod(time * spd + phase, 6.2831);
                px += sin(ft) * driftAmount * 0.5;
                py += sin(ft * 1.3 + 1.0) * driftAmount;
                pz += sin(ft * 0.7 + 2.0) * driftAmount * 0.3;
            
                float edge = min(progress, 1.0 - progress) * 5.0;
                float scale = particleScale * min(edge, 1.0);
            
                float symbolBrightness = 2.0;
            
                vec3 spawnPos = vec3(px, py, pz);
                vec3 worldCenter = (system.getMatrixWorld() * vec4(spawnPos, 1.0)).xyz;
            
                vec2 quadUV = system.getSurfaceUVCoord0();
                vec2 uvOff = quadUV - 0.5;
            
                // Y-axis billboard: project camera forward to XZ, normalize, derive right
                // as cross(worldUp, fwdFlat). With up=(0,1,0) and fwdFlat.y=0, the cross
                // collapses to (fwdFlat.z, 0, -fwdFlat.x) -> 6-op cross becomes a swizzle.
                mat4 camMat = system.getMatrixCamera();
                vec3 fwdFlat = vec3(camMat[2].x, 0.0, camMat[2].z);
                fwdFlat *= inversesqrt(max(dot(fwdFlat, fwdFlat), 1e-8));
            
                vec3 up = vec3(0.0, 1.0, 0.0);
                vec3 right = vec3(fwdFlat.z, 0.0, -fwdFlat.x);
            
                position = worldCenter + (right * uvOff.x + up * uvOff.y) * scale;
            
                // PRECISION: wrap cycleId so hash input stays FP16-safe.
                // Without wrap, after ~120 cycles `id + cycleId * 17` exceeds FP16 int precision (2048).
                float cycleIdW = mod(cycleId, 16.0);
                // Atlas cell: single hash drives both row (int part of g) and col (fract * 8).
                float g = hash(id + cycleIdW * 11.3) * 8.0;
                float cellY = floor(g);
                float cellX = floor(fract(g) * 8.0);
                vec2 atlasUV = (vec2(cellX, cellY) + quadUV) * 0.125;
                vec4 glyph = glyphAtlas.sample(atlasUV);
            
                float glyphMask = glyph.r;
            
                #ifdef FRAGMENT
                if (glyphMask < 0.01) {
                    discard;
                }
                #endif
            
                vec4 tintColor = mix(startColor, endColor, progress) * symbolBrightness;
                color = vec4(tintColor.rgb * glyphMask, tintColor.a * glyphMask);
            }

        CustomCodeNodeAsset:
          ClassType1: REFUID
          BaseType: Asset.CustomCodeNodeAsset
          ScriptType: All
