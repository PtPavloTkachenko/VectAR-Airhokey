# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# Secrets — never commit credentials
.env
*.pem
*.key
*.cert
*.jwt
sdk_config.ini

# ...with one deliberate exception. This is not a credential of ours: it is the
# public Digital Dream Labs escape-pod key, published with wire-pod, and every
# escape-pod robot in the world already trusts its certificate. The pairing
# engine cannot start in escape-pod mode without it, and that mode is what BOTH
# a stock and a dev robot need — so leaving it out made a fresh clone unusable
# while the certificate beside it shipped fine.
!server/onboarding/wire-pod/chipper/epod/ep.key

# Lens Studio machine-local / regenerable. The glob covers every lens folder,
# so a second one (lens-523/) does not quietly start committing its caches.
lens*/Cache/
lens*/Workspaces/
lens*/Support/
lens*/PluginsUserPreferences/
lens*/*.lock
lens*/BackUp/
**/.mcp.json
.cursor/
.vscode/

# OS
.DS_Store

# Logs
*.log

# certs (ep.crt stays — public escape-pod CA, already tracked)
*.crt
*.p12
*.pfx

# The pairing engine's per-robot state: the robots' session certificates and
# the SDK keys it issued them. Machine-local secrets, and the cert files have
# no extension for *.cert above to catch. The directories must EXIST for the
# engine to write anything (it only creates them when packaged) — the server
# makes them on start, so ignoring them costs nothing.
server/onboarding/wire-pod/chipper/jdocs/
server/onboarding/wire-pod/chipper/session-certs/

# built pairing server (build locally: go build -tags inbuiltble)
server/onboarding/wire-pod/chipper/vectar-onboard
